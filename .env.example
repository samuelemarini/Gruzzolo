# Sviluppo: copia in .env (non versionato). Produzione: imposta le stesse variabili nello stack
# (Portainer: "Environment variables") e usa docker-compose.prod.yml.

# Password del database. Solo lettere e numeri: finisce dentro DATABASE_URL.
DB_PASSWORD=cambiami

# --- solo produzione (in sviluppo stanno in app/.env.local) ---
# openssl rand -hex 16
APP_SECRET=
# Crea l'utente "admin" al primo avvio; poi cambiala dalle Impostazioni
ADMIN_PASSWORD=
# Porte pubblicate sull'host (in sviluppo i default sono 20029 e 30029)
WEB_PORT=8080
DB_PORT=3308
# 127.0.0.1 = database raggiungibile solo dal server, 0.0.0.0 = da tutta la rete
DB_BIND=127.0.0.1
