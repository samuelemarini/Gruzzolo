{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}
{% block title %}{{ 'Report'|trans }}{% endblock %}
{% set q = app.request.query %}
{# Scelta dei conti da mantenere in tutti i link (senza parametro = solo il conto principale) #}
{% set acc = accountParam is not null ? {account: accountParam} : {} %}
{% set listPeriod = (period == 'month' ? {period: 'month', month: from|date('Y-m')} : {period: 'custom', from: from|date('Y-m-d'), to: to|date('Y-m-d')})|merge({account: movementAccounts}) %}
{% block body %}
<div class="page page--wide" data-controller="sheet">
    <div class="topbar">
        <h1 class="topbar__title">{{ 'Report'|trans }}</h1>
        <div class="topbar__actions">
            {{ ui.privacy_toggle() }}
            <a href="{{ path('movement_export', listPeriod) }}" class="icon-btn" aria-label="{{ 'Esporta CSV del periodo'|trans }}" data-turbo="false">{{ icon('download', 19) }}</a>
        </div>
    </div>

    <div class="cols">
    <div class="col-main">
        <div class="seg" role="tablist" aria-label="{{ 'Periodo'|trans }}">
            <a href="{{ path('report_index', {period: 'month', kind: kind}|merge(acc)) }}" class="{{ period == 'month' ? 'is-active' }}">{{ 'Mese'|trans }}</a>
            <a href="{{ path('report_index', {period: 'year', kind: kind}|merge(acc)) }}" class="{{ period == 'year' ? 'is-active' }}">{{ 'Anno'|trans }}</a>
            <button type="button" class="{{ period == 'custom' ? 'is-active' }}" data-action="sheet#open">{{ 'Intervallo'|trans }}</button>
        </div>

        {% if chips|length > 2 %}
            {# Come nei Movimenti: un tocco guarda solo quel conto, tenendo premuto lo aggiunge o lo toglie #}
            <div class="chips chips--scroll chips--hold" aria-label="{{ 'Conti'|trans }}" data-controller="chip-hold">
                {% for c in chips %}
                    {% if c.only %}
                        <a class="chip {{ c.active ? 'is-active' }}" href="{{ path('report_index', q.all|merge({account: c.only})) }}"
                           data-hold-href="{{ path('report_index', q.all|merge({account: c.param})) }}" draggable="false"
                           data-action="pointerdown->chip-hold#press pointermove->chip-hold#move pointerup->chip-hold#cancel pointercancel->chip-hold#cancel pointerleave->chip-hold#cancel click->chip-hold#click contextmenu->chip-hold#menu">
                    {% else %}
                        <a class="chip {{ c.active ? 'is-active' }}" href="{{ path('report_index', q.all|merge({account: c.param})) }}">
                    {% endif %}{% if c.icon %}{{ icon(c.icon, 15) }}{% elseif c.color %}<span class="chip__dot" style="--c: {{ c.color }}"></span>{% endif %}{{ c.label }}</a>
                {% endfor %}
            </div>
        {% endif %}

        {% if period == 'month' %}
            {% set prev = from|date_modify('-1 month') %}{% set next = from|date_modify('+1 month') %}
            <div class="month-nav month-nav--plain">
                <a href="{{ path('report_index', {month: prev|date('Y-m'), kind: kind}|merge(acc)) }}" aria-label="{{ 'Mese precedente'|trans }}">{{ icon('chevron-left', 20) }}</a>
                <span>{{ from|month_label }}</span>
                <a href="{{ path('report_index', {month: next|date('Y-m'), kind: kind}|merge(acc)) }}" aria-label="{{ 'Mese successivo'|trans }}">{{ icon('chevron-right', 20) }}</a>
            </div>
        {% elseif period == 'year' %}
            {% set y = from|date('Y') %}
            <div class="month-nav month-nav--plain">
                <a href="{{ path('report_index', {period: 'year', year: y - 1, kind: kind}|merge(acc)) }}" aria-label="{{ 'Anno precedente'|trans }}">{{ icon('chevron-left', 20) }}</a>
                <span>{{ y }}</span>
                <a href="{{ path('report_index', {period: 'year', year: y + 1, kind: kind}|merge(acc)) }}" aria-label="{{ 'Anno successivo'|trans }}">{{ icon('chevron-right', 20) }}</a>
            </div>
        {% else %}
            <div class="month-nav month-nav--plain" style="justify-content: center">
                <span>{{ from|local_date('d MMM yyyy') }} – {{ to|local_date('d MMM yyyy') }}</span>
            </div>
        {% endif %}

        <section class="card" aria-label="{{ 'Saldo del periodo'|trans }}">
            <div class="stack-sm" style="gap: 4px">
                <span class="small muted">{{ period == 'month' ? 'Saldo di %month%'|trans({'%month%': from|local_date('LLLL')}) : (period == 'year' ? 'Saldo del %year%'|trans({'%year%': from|date('Y')}) : 'Saldo del periodo'|trans) }}</span>
                {% set net = summary.net %}
                <div class="hero-amount">
                    <span class="hero-amount__value {{ net < 0 ? 'text-expense' }}">{{ net > 0 ? '+' }}{{ net < 0 ? '−' }}{{ net|abs|num(2) }}</span>
                    <span class="hero-amount__cur">€</span>
                </div>
            </div>
            <div class="grid-2">
                <div class="stat stat--inner">
                    <span class="stat__label"><span class="tile tile--xs" style="--c: var(--income)">{{ icon('arrow-down-left', 15) }}</span>{{ 'Entrate'|trans }}</span>
                    <span class="stat__value">{{ summary.income|money }}</span>
                </div>
                <div class="stat stat--inner">
                    <span class="stat__label"><span class="tile tile--xs" style="--c: #FF8A80">{{ icon('arrow-up-right', 15) }}</span>{{ 'Uscite'|trans }}</span>
                    <span class="stat__value">{{ summary.expense|money }}</span>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="row row--between">
                <h2 class="h2">{{ 'Per categoria'|trans }}</h2>
                <div class="seg seg--inset seg--sm" style="width: 170px">
                    <a href="{{ path('report_index', q.all|merge({kind: 'expense'})) }}" class="{{ kind == 'expense' ? 'is-active' }}">{{ 'Uscite'|trans }}</a>
                    <a href="{{ path('report_index', q.all|merge({kind: 'income'})) }}" class="{{ kind == 'income' ? 'is-active' }}">{{ 'Entrate'|trans }}</a>
                </div>
            </div>
            {% set total = kind == 'income' ? summary.income : summary.expense %}
            {{ ui.donut(donut, total|money, kind == 'income' ? 'entrate totali'|trans : 'uscite totali'|trans, (kind == 'income' ? 'Entrate per categoria: %list%' : 'Uscite per categoria: %list%')|trans({'%list%': byCategory|map(g => g.name ~ ' ' ~ g.pct|pct)|join(', ')})) }}

            {% if byCategory is empty %}
                <p class="muted small" style="text-align: center">{{ kind == 'income' ? 'Nessuna entrata nel periodo.'|trans : 'Nessuna uscita nel periodo.'|trans }}</p>
            {% else %}
                {% set maxTotal = byCategory|first.total %}
                <div class="list">
                    {% for g in byCategory %}
                        <a class="list-row" style="min-height: 56px" href="{{ g.holding ? path('investment_show', {id: g.holding}) : path('movement_index', listPeriod|merge(g.transfer ? {kind: 'transfer'} : {kind: kind, cat: g.ids})) }}">
                            {{ ui.tile(g.icon, g.color, 'sm') }}
                            <div class="list-row__body" style="gap: 6px">
                                <div class="row row--between" style="font-size: 14px"><span class="strong ellipsis" style="font-weight: 500">{{ g.name }}</span><span class="strong">{{ g.total|money }}</span></div>
                                <div class="row" style="gap: 8px">
                                    <div class="progress grow" style="height: 5px; --c: {{ g.color }}"><span style="width: {{ (g.total / maxTotal * 100)|round(1) }}%"></span></div>
                                    <span class="xsmall muted" style="width: 36px; text-align: right">{{ g.pct|pct }}</span>
                                </div>
                                {% if g.children|length > 0 %}
                                    <span class="xsmall muted ellipsis">{% for c in g.children %}{{ c.category.name }} {{ c.total|money(false, 0) }}{{ not loop.last ? ' · ' }}{% endfor %}</span>
                                {% endif %}
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </div>

    <div class="col-side">
        {% if investments %}
            <a class="card" href="{{ path('investment_index') }}" aria-label="{{ 'Investimenti nel periodo'|trans }}">
                <div class="row row--between">
                    <span class="row" style="gap: 10px">{{ ui.tile('trending-up', '#7FD6FF', 'sm') }}<span class="strong">{{ 'Rendimento del periodo'|trans }}</span></span>
                    {{ icon('chevron-right', 18, 'faint') }}
                </div>
                <div class="row row--between" style="align-items: baseline">
                    <span class="display {{ investments.gain >= 0 ? 'text-income' : 'text-expense' }}" style="font-size: 26px; font-weight: 700">{{ investments.gain|money(true) }}</span>
                    {% if investments.pct is not null %}<span class="strong {{ investments.gain >= 0 ? 'text-income' : 'text-expense' }}">{{ investments.pct|pct(1, true) }}</span>{% endif %}
                </div>
                <div class="grid-3 small">
                    <div class="stack-sm" style="gap: 2px"><span class="xsmall muted">{{ 'Valore a inizio'|trans }}</span><span class="strong">{{ investments.start|money(false, 0) }}</span></div>
                    <div class="stack-sm" style="gap: 2px"><span class="xsmall muted">{{ 'Versato'|trans }}</span><span class="strong">{{ investments.contributions|money(true, 0) }}</span></div>
                    <div class="stack-sm" style="gap: 2px"><span class="xsmall muted">{{ 'Valore a fine'|trans }}</span><span class="strong">{{ investments.end|money(false, 0) }}</span></div>
                </div>
            </a>
        {% endif %}
        <div class="grid-2">
            <div class="stat">
                <span class="stat__label">{{ 'Media al giorno'|trans }}</span>
                <span class="stat__value" style="font-size: 22px">{{ dailyAverage is not null ? dailyAverage|money : '—' }}</span>
                <span class="stat__sub">{{ 'uscite su %count% giorno|uscite su %count% giorni'|trans({'%count%': days}) }}</span>
            </div>
            <div class="stat">
                <span class="stat__label">{{ 'Spesa più alta'|trans }}</span>
                <span class="stat__value" style="font-size: 22px">{{ biggest ? biggest.amount|money : '—' }}</span>
                <span class="stat__sub ellipsis">{{ biggest ? (biggest.description ?: biggest.category) }}</span>
            </div>
        </div>

        <section class="card">
            <div class="stack-sm" style="gap: 4px">
                <h2 class="h2">{{ 'Entrate e uscite'|trans }}</h2>
                <span class="small muted">{{ '%count% mese|%count% mesi'|trans({'%count%': bars.rows|length}) }} · {{ savedTrend >= 0 ? 'risparmiati'|trans : 'spesi più del guadagnato'|trans }} <span class="strong {{ savedTrend >= 0 ? 'text-income' : 'text-expense' }}">{{ savedTrend|money(true) }}</span></span>
            </div>
            <div class="bars" role="img" aria-label="{{ 'Entrate e uscite per mese'|trans }}">
                {% for r in bars.rows %}
                    <div class="bars__group" title="{{ '%month%: entrate %income%, uscite %expense%'|trans({'%month%': r.month|month_label, '%income%': r.income|money, '%expense%': r.expense|money}) }}">
                        <span class="bars__bar {{ r.partial ? 'is-partial' }}" style="--c: var(--income); height: {{ r.incomePct }}%"></span>
                        <span class="bars__bar {{ r.partial ? 'is-partial' }}" style="--c: #FF8A80; height: {{ r.expensePct }}%"></span>
                    </div>
                {% endfor %}
            </div>
            <div class="bars__labels">
                {% for r in bars.rows %}<span>{{ r.month|local_date(bars.rows|length > 8 ? 'LLLLL' : 'LLL')|capitalize }}</span>{% endfor %}
            </div>
            <div class="chart-legend">
                <span><i style="--c: var(--income)"></i>{{ 'Entrate'|trans }}</span>
                <span><i style="--c: #FF8A80"></i>{{ 'Uscite'|trans }}</span>
                {% if bars.rows|filter(r => r.partial)|length %}<span style="margin-left: auto">{{ 'mese in corso più chiaro'|trans }}</span>{% endif %}
            </div>
        </section>

        {% if tags is not empty %}
        <section class="card card--list" style="padding-top: 16px">
            <h2 class="h2" style="padding-bottom: 6px">{{ 'Per etichetta'|trans }}</h2>
            {% for t in tags %}
                <a class="list-row" href="{{ path('tag_show', {id: t.id}) }}">
                    {{ ui.tile('tag', t.color, 'sm') }}
                    <div class="list-row__body">
                        <span class="list-row__title">#{{ t.name }}</span>
                        <span class="list-row__meta">{{ t.title ?: '%count% movimento nel periodo|%count% movimenti nel periodo'|trans({'%count%': t.count}) }}</span>
                    </div>
                    <span class="list-row__amount">{{ t.expense|money }}</span>
                    {{ icon('chevron-right', 18, 'list-row__chev') }}
                </a>
            {% endfor %}
        </section>
        {% endif %}
    </div>
    </div>

    <dialog class="sheet" data-sheet-target="dialog" data-action="click->sheet#backdrop" aria-label="{{ 'Intervallo'|trans }}">
        <form method="get" action="{{ path('report_index') }}" class="sheet__inner">
            <div class="sheet__grabber"></div>
            <div class="sheet__head">
                <span class="sheet__title">{{ 'Intervallo'|trans }}</span>
                <button type="button" class="icon-btn icon-btn--plain" data-action="sheet#close" aria-label="{{ 'Chiudi'|trans }}">{{ icon('x') }}</button>
            </div>
            <input type="hidden" name="period" value="custom">
            <input type="hidden" name="kind" value="{{ kind }}">
            {% for token in accountParam ?? [] %}<input type="hidden" name="account[]" value="{{ token }}">{% endfor %}
            <div class="grid-2">
                <label class="field"><span class="field__label">{{ 'Dal'|trans }}</span><input type="date" name="from" value="{{ from|date('Y-m-d') }}" required></label>
                <label class="field"><span class="field__label">{{ 'Al'|trans }}</span><input type="date" name="to" value="{{ to|date('Y-m-d') }}" required></label>
            </div>
            <button type="submit" class="btn btn--block">{{ 'Mostra'|trans }}</button>
        </form>
    </dialog>
</div>
{% endblock %}
