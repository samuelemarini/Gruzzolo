{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}
{% block title %}{{ 'Categorie'|trans }}{% endblock %}
{% block body %}
<div class="page">
    <div class="topbar">
        <h1 class="topbar__title">{{ 'Categorie'|trans }}</h1>
        <div class="topbar__actions">
            <a href="{{ path('category_sort', {account: account.id, kind: kind}) }}" class="icon-btn" aria-label="{{ 'Ordina categorie'|trans }}">{{ icon('arrow-down-up', 19) }}</a>
            <a href="{{ path('category_new', {account: account.id, kind: kind}) }}" class="icon-btn" aria-label="{{ 'Nuova categoria'|trans }}">{{ icon('plus') }}</a>
        </div>
    </div>

    {# Ogni conto ha le sue categorie #}
    {% if accounts|length > 1 %}
        <div class="chips chips--scroll" aria-label="{{ 'Conto'|trans }}">
            {% for a in accounts %}
                <a class="chip {{ a == account ? 'is-active' }}" href="{{ path('category_index', {account: a.id, kind: kind}) }}"><span class="chip__dot" style="--c: {{ a.color }}"></span>{{ a.name }}{% if a.user != app.user %} · {{ 'di %name%'|trans({'%name%': a.user.displayName}) }}{% elseif a.shared %} · {{ 'condiviso'|trans }}{% endif %}</a>
            {% endfor %}
        </div>
    {% endif %}

    <div class="seg">
        <a href="{{ path('category_index', {account: account.id}) }}" class="{{ kind == 'expense' ? 'is-active' }}">{{ 'Uscite'|trans }} · {{ expenseCount }}</a>
        <a href="{{ path('category_index', {account: account.id, kind: 'income'}) }}" class="{{ kind == 'income' ? 'is-active' }}">{{ 'Entrate'|trans }} · {{ incomeCount }}</a>
    </div>

    <div class="card card--list">
        {% for parent in tree|filter(p => not p.archived) %}
            {% set uses = (counts[parent.id] ?? 0) + parent.children|reduce((s, c) => s + (counts[c.id] ?? 0), 0) %}
            <a class="list-row" href="{{ path('category_edit', {id: parent.id}) }}">
                {{ ui.tile(parent.icon, parent.color) }}
                <div class="list-row__body">
                    <span class="list-row__title">{{ parent.name }}{% if parent.fuel %} <span class="badge badge--accent">{{ 'carburante'|trans }}</span>{% endif %}</span>
                    <span class="list-row__meta">
                        {%- set kids = parent.children|filter(c => not c.archived) -%}
                        {%- if kids|length -%}{{ kids|map(c => c.name)|join(', ') }}{%- else -%}{{ '%count% movimento|%count% movimenti'|trans({'%count%': uses}) }}{%- endif -%}
                    </span>
                </div>
                {{ icon('chevron-right', 18, 'list-row__chev') }}
            </a>
        {% else %}
            {{ ui.empty('layout-grid', (kind == 'income' ? 'Il conto «%name%» non ha ancora categorie di entrata.' : 'Il conto «%name%» non ha ancora categorie di uscita.')|trans({'%name%': account.name}), path('category_new', {account: account.id, kind: kind}), 'Nuova categoria'|trans) }}
        {% endfor %}
    </div>

    <a href="{{ path('category_new', {account: account.id, kind: kind}) }}" class="btn btn--outline btn--block btn--sm">{{ icon('plus', 18) }}{{ 'Nuova categoria'|trans }}</a>

    {% set others = accounts|filter(a => a != account) %}
    {% if others|length %}
        <form method="post" action="{{ path('category_copy') }}" class="card card--tight" data-confirm-kind="copy" data-turbo-confirm="{{ 'Copiare in «%name%» le categorie che mancano?'|trans({'%name%': account.name}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('category-copy') }}">
            <input type="hidden" name="account" value="{{ account.id }}">
            <span class="small muted">{{ 'Copia in questo conto le categorie di un altro conto (quelle che ci sono già non si duplicano).'|trans }}</span>
            <div class="row" style="gap: 8px">
                <label class="field grow" style="padding: 8px 14px"><span class="sr-only">{{ 'Da quale conto'|trans }}</span>
                    <select name="from">{% for a in others %}<option value="{{ a.id }}">{{ a.name }}</option>{% endfor %}</select>
                </label>
                <button type="submit" class="btn btn--sm btn--ghost">{{ icon('repeat', 18) }}{{ 'Copia'|trans }}</button>
            </div>
        </form>
    {% endif %}

    {% set archived = tree|filter(p => p.archived) %}
    {% if archived|length %}
        <div class="section-head"><h2>{{ 'Archiviate'|trans }}</h2></div>
        <div class="card card--list">
            {% for parent in archived %}
                <a class="list-row" href="{{ path('category_edit', {id: parent.id}) }}" style="opacity: .65">
                    {{ ui.tile(parent.icon, parent.color, 'sm') }}
                    <div class="list-row__body"><span class="list-row__title">{{ parent.name }}</span></div>
                    {{ icon('chevron-right', 18, 'list-row__chev') }}
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
