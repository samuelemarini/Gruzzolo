{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}
{% block title %}{{ 'Investimenti'|trans }}{% endblock %}
{% block body %}
<div class="page page--wide">
    <div class="topbar">
        <h1 class="topbar__title">{{ 'Investimenti'|trans }}</h1>
        <div class="topbar__actions">
            {{ ui.privacy_toggle() }}
            <a href="{{ path('investment_new') }}" class="icon-btn" aria-label="{{ 'Nuovo titolo'|trans }}">{{ icon('plus') }}</a>
        </div>
    </div>

    {% if portfolio.holdings is empty %}
        {{ ui.empty('trending-up', 'Aggiungi i tuoi titoli (ETF, azioni, crypto) e ogni tanto registra quanto hai versato e quanto valgono: Gruzzolo calcola il rendimento.'|trans, path('investment_new'), 'Aggiungi titolo'|trans) }}
    {% else %}
    <div class="cols">
        <div class="col-main">
            <section class="card">
                {# Con i prezzi di mercato: valore stimato oggi; altrimenti l'ultimo registrato #}
                {% set value = live ? live.value : portfolio.value %}
                {% set gain = live ? live.gain : portfolio.gain %}
                {% set gainPct = live ? live.pct : portfolio.pct %}
                <span class="small muted">{{ live ? 'Valore stimato oggi'|trans : 'Valore del portafoglio'|trans }}</span>
                <div class="hero-amount"><span class="hero-amount__value">{{ value|num(2) }}</span><span class="hero-amount__cur">€</span></div>
                {% if live %}
                    <span class="small"><span class="strong {{ live.change >= 0 ? 'text-income' : 'text-expense' }}">{{ live.change|money(true) }} ({{ live.changePct|pct(2, true) }})</span> <span class="muted">{{ 'dall\'ultimo aggiornamento (%value%)'|trans({'%value%': portfolio.value|money}) }}</span></span>
                    <span class="xsmall muted">{{ 'Prezzi di mercato delle %time% del %date%'|trans({'%time%': live.time|date('H:i'), '%date%': live.time|local_date('d MMM')}) }}{{ live.count < portfolio.holdings|length ? ' · ' ~ '%count% titoli su %total%'|trans({'%count%': live.count, '%total%': portfolio.holdings|length}) }}</span>
                {% endif %}
                <form method="post" action="{{ path('investment_live_toggle') }}" class="row live-toggle">
                    <input type="hidden" name="_token" value="{{ csrf_token('investment-live') }}">
                    {{ icon(liveEnabled ? 'trending-up' : 'eye-off', 16, 'muted') }}
                    <span class="xsmall muted grow">{{ liveEnabled ? 'Stima di oggi dai prezzi di mercato attiva'|trans : 'Stima di oggi disattivata: valori registrati'|trans }}</span>
                    <button type="submit" class="chip" style="height: 30px; font-size: 13px">{{ liveEnabled ? 'Disattiva'|trans : 'Attiva'|trans }}</button>
                </form>
                <div class="grid-2">
                    <div class="stat stat--inner"><span class="stat__label">{{ 'Versati'|trans }}</span><span class="stat__value">{{ portfolio.invested|money }}</span></div>
                    <div class="stat stat--inner"><span class="stat__label">{{ 'Rendimento'|trans }}</span><span class="stat__value {{ gain >= 0 ? 'text-income' : 'text-expense' }}">{{ gain|money(true) }}</span><span class="stat__sub">{{ gainPct|pct(1, true) }}</span></div>
                </div>
                {% if timeline|length >= 2 %}
                    {{ ui.line_chart(chart, {value: 'var(--accent-text)', invested: 'muted'}, 'Valore del portafoglio e somma versata nel tempo'|trans) }}
                    <div class="chart-legend">
                        <span><i class="line" style="--c: var(--accent-text)"></i>{{ 'valore'|trans }}</span>
                        <span><i class="dashed" style="--c: var(--muted)"></i>{{ 'versato'|trans }}</span>
                        <span style="margin-left: auto">{{ (timeline|first).date|local_date('MMM yyyy') }} – {{ (timeline|last).date|local_date('MMM yyyy') }}</span>
                    </div>
                {% endif %}
            </section>
        </div>
        <div class="col-side">
            <section class="stack-sm">
                <div class="section-head"><h2>{{ 'Titoli'|trans }}</h2></div>
                {% for item in portfolio.holdings %}
                    {% set h = item.holding %}{% set s = item.stats %}{% set e = live ? live.items[h.id] ?? null : null %}
                    <a class="card card--tight" href="{{ path('investment_show', {id: h.id}) }}"{{ h.excludedFromReturns ? ' style="opacity: .75"' }}>
                        <div class="row">
                            {{ ui.tile(h.icon, h.color, 'sm') }}
                            <div class="grow stack-sm" style="gap: 1px">
                                <span class="strong ellipsis">{{ h.name }}</span>
                                <span class="xsmall muted">{{ h.kindLabel|trans }}{{ h.excludedFromReturns ? ' · ' ~ 'escluso dal rendimento'|trans }}{{ s.lastDate ? ' · ' ~ 'agg. %date%'|trans({'%date%': s.lastDate|short_day|lower}) }}{% if e %} · <span class="{{ e.changePct >= 0 ? 'text-income' : 'text-expense' }}">{{ '%pct% da allora'|trans({'%pct%': e.changePct|pct(1, true)}) }}</span>{% endif %}</span>
                            </div>
                            <div class="stack-sm" style="gap: 1px; align-items: flex-end">
                                <span class="strong">{{ (e ? e.value : s.value)|money }}</span>
                                <span class="xsmall strong {{ (e ? e.gain : s.gain) >= 0 ? 'text-income' : 'text-expense' }}">{{ (e ? e.gain : s.gain)|money(true) }} · {{ (e ? e.pct : s.pct)|pct(1, true) }}</span>
                            </div>
                        </div>
                        {% if portfolio.value > 0 and not h.excludedFromReturns %}
                            <div class="progress" style="--c: {{ h.color }}"><span style="width: {{ ((e ? e.value : s.value) / value * 100)|round(1) }}%"></span></div>
                        {% endif %}
                    </a>
                {% endfor %}
                <a href="{{ path('investment_new') }}" class="btn btn--outline btn--block btn--sm">{{ icon('plus', 18) }}{{ 'Aggiungi titolo'|trans }}</a>
            </section>
            {% if archived|length %}
                <div class="section-head"><h2>{{ 'Archiviati'|trans }}</h2></div>
                <div class="card card--list">
                    {% for h in archived %}
                        <a class="list-row" href="{{ path('investment_show', {id: h.id}) }}" style="opacity: .65">
                            {{ ui.tile(h.icon, h.color, 'sm') }}
                            <div class="list-row__body"><span class="list-row__title">{{ h.name }}</span></div>
                            {{ icon('chevron-right', 18, 'list-row__chev') }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
