{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}
{% set hide_tabbar = true %}
{% set isNew = account.id is null %}
{% block title %}{{ isNew ? 'Nuovo conto'|trans : account.name }}{% endblock %}
{% block body %}
<form method="post" class="page page--plain form">
    <input type="hidden" name="_token" value="{{ csrf_token('account') }}">
    <div class="topbar">
        <a href="{{ isNew ? path('account_index') : path('account_show', {id: account.id}) }}" class="icon-btn" aria-label="{{ 'Indietro'|trans }}">{{ icon('chevron-left') }}</a>
        <span class="topbar__center">{{ isNew ? 'Nuovo conto'|trans : 'Modifica conto'|trans }}</span>
        <span style="width: 44px"></span>
    </div>
    <label class="field {{ errors.name is defined ? 'has-error' }}">
        <span class="field__label">{{ 'Nome'|trans }}</span>
        <input type="text" name="name" value="{{ account.name }}" maxlength="80" required placeholder="{{ 'es. Accantonamento'|trans }}" {{ isNew ? 'autofocus' }}>
        {% if errors.name is defined %}<span class="field__error">{{ errors.name }}</span>{% endif %}
    </label>
    <label class="field">
        <span class="field__label">{{ 'Tipo'|trans }}</span>
        <select name="kind">{% for k, label in kinds %}<option value="{{ k }}" {{ account.kind == k ? 'selected' }}>{{ label }}</option>{% endfor %}</select>
    </label>
    <label class="field {{ errors.initial_balance is defined ? 'has-error' }}">
        <span class="field__label">{{ 'Saldo iniziale'|trans }} €</span>
        <input type="text" name="initial_balance" inputmode="decimal" value="{{ account.initialBalance|input_num }}" placeholder="{{ 0|input_num }}">
        {% if errors.initial_balance is defined %}<span class="field__error">{{ errors.initial_balance }}</span>{% endif %}
    </label>
    <p class="hint">{{ 'Il saldo del conto prima del primo movimento registrato qui.'|trans }}</p>
    {% if isNew %}
        <label class="field">
            <span class="field__label">{{ 'Categorie del conto'|trans }}</span>
            <select name="categories_from">
                {% for a in sources %}<option value="{{ a.id }}" {{ a == defaultSource ? 'selected' }}>{{ 'Copia da «%name%»'|trans({'%name%': a.name}) }}</option>{% endfor %}
                <option value="default" {{ defaultSource is null ? 'selected' }}>{{ 'Categorie predefinite'|trans }}</option>
                <option value="none">{{ 'Nessuna, le creo io'|trans }}</option>
            </select>
        </label>
        <p class="hint">{{ 'Ogni conto ha le sue categorie: le puoi cambiare quando vuoi da Categorie.'|trans }}</p>
    {% endif %}
    <section class="card card--tight">
        <span class="label-caps">{{ 'Colore'|trans }}</span>
        {{ ui.color_picker('color', account.color) }}
    </section>
    <div class="card card--tight" style="gap: 0">
        <label class="switch">
            <span class="switch__text"><span>{{ 'Conto predefinito'|trans }}</span><small>{{ 'proposto quando inserisci un movimento'|trans }}</small></span>
            <input type="checkbox" name="default" value="1" {{ account.default ? 'checked' }}>
        </label>
        <label class="switch">
            <span class="switch__text"><span>{{ 'Visualizza nella home'|trans }}</span><small>{{ 'se spento resta il saldo, ma i movimenti non entrano nei totali e negli ultimi movimenti (solo per te)'|trans }}</small></span>
            <input type="checkbox" name="home" value="1" {{ account.onHomeFor(app.user) ? 'checked' }}>
        </label>
        {% if not isNew %}
            <label class="switch">
                <span class="switch__text"><span>{{ 'Archiviato'|trans }}</span><small>{{ 'non compare più nei selettori'|trans }}</small></span>
                <input type="checkbox" name="archived" value="1" {{ account.archived ? 'checked' }}>
            </label>
        {% endif %}
    </div>
    <button type="submit" class="btn btn--block">{{ icon('check', 20) }}{{ 'Salva'|trans }}</button>
</form>
{% if not isNew %}
    <section class="page page--plain" style="padding-top: 0">
        <div class="card card--tight">
            <div class="row">{{ icon('users', 20) }}<h2 class="h2 grow" style="font-size: 17px">{{ 'Condivisione'|trans }}</h2></div>
            <p class="small muted">{{ 'Chi riceve il conto ne vede il saldo e tutti i movimenti e può aggiungerne, con le sue categorie. Modificarlo o eliminarlo resta a te.'|trans }}</p>
            {% for u in account.members %}
                <div class="row" style="min-height: 44px">
                    <span class="tile tile--sm" style="--c: #8AB4FF">{{ icon('user', 18) }}</span>
                    <span class="grow stack-sm" style="gap: 0"><span class="strong">{{ u.displayName }}</span><span class="xsmall muted">{{ u.username }}</span></span>
                    <form method="post" action="{{ path('account_unshare', {id: account.id, userId: u.id}) }}" data-confirm-kind="remove" data-turbo-confirm="{{ 'Togliere %name% dal conto? I movimenti che ha inserito restano.'|trans({'%name%': u.displayName}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('account-unshare-' ~ account.id ~ '-' ~ u.id) }}">
                        <button type="submit" class="chip" style="height: 34px">{{ icon('x', 15) }}{{ 'Togli'|trans }}</button>
                    </form>
                </div>
            {% endfor %}
            <form method="post" action="{{ path('account_share', {id: account.id}) }}" class="row" style="gap: 8px">
                <input type="hidden" name="_token" value="{{ csrf_token('account-share-' ~ account.id) }}">
                <label class="field grow" style="padding: 8px 14px"><span class="sr-only">{{ 'Nome utente'|trans }}</span><input type="text" name="username" placeholder="{{ 'nome utente con cui condividere'|trans }}" autocapitalize="none" autocomplete="off" required></label>
                <button type="submit" class="btn btn--sm">{{ 'Condividi'|trans }}</button>
            </form>
        </div>
    </section>
    <form method="post" action="{{ path('account_delete', {id: account.id}) }}" class="page page--plain" style="padding-top: 0" data-confirm-kind="delete" data-turbo-confirm="{{ 'Eliminare il conto?'|trans }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-account-' ~ account.id) }}">
        <button type="submit" class="btn btn--danger btn--block btn--sm">{{ icon('trash-2', 18) }}{{ 'Elimina conto'|trans }}</button>
    </form>
{% endif %}
{% endblock %}
