{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}
{% block title %}{{ 'Altro'|trans }}{% endblock %}
{% block body %}
<div class="page">
    <div class="topbar"><h1 class="topbar__title">{{ 'Altro'|trans }}</h1></div>
    <div class="menu-grid">
        {% for item in [
            ['account_index', 'landmark', '#8AB4FF', 'Conti'|trans, 'Saldi e giroconti'|trans],
            ['investment_index', 'trending-up', '#7FD6FF', 'Investimenti'|trans, 'Versamenti e rendimento'|trans],
            ['vehicle_index', 'car', '#6FDCCB', 'Veicoli'|trans, 'Rifornimenti e consumi'|trans],
            ['category_index', 'layout-grid', '#FFB86B', 'Categorie'|trans, 'Icone, colori, sottocategorie'|trans],
            ['tag_index', 'tag', '#C3A6FF', 'Etichette'|trans, 'Viaggi, eventi, progetti'|trans],
            ['import_index', 'file-up', '#9BE7A0', 'Importa'|trans, 'CSV da altre app'|trans],
            ['settings_index', 'settings', '#A3A59F', 'Impostazioni'|trans, 'Tema, profilo, password'|trans],
        ] %}
            <a class="menu-card" href="{{ path(item[0]) }}">
                {{ ui.tile(item[1], item[2]) }}
                <span class="menu-card__title">{{ item[3] }}</span>
                <span class="menu-card__sub">{{ item[4] }}</span>
            </a>
        {% endfor %}
        {% if is_granted('ROLE_ADMIN') %}
            <a class="menu-card" href="{{ path('admin_user_index') }}">
                {{ ui.tile('users', '#FF9EC7') }}
                <span class="menu-card__title">{{ 'Utenti'|trans }}</span>
                <span class="menu-card__sub">{{ 'Crea e gestisci gli accessi'|trans }}</span>
            </a>
            <a class="menu-card" href="{{ path('admin_backup') }}">
                {{ ui.tile('archive', '#9BE7A0') }}
                <span class="menu-card__title">{{ 'Backup'|trans }}</span>
                <span class="menu-card__sub">{{ 'Esporta e ripristina tutti i dati'|trans }}</span>
            </a>
        {% endif %}
    </div>
    <form method="post" action="{{ path('app_logout') }}" data-turbo="false">
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
        <button type="submit" class="btn btn--ghost btn--block btn--sm">{{ icon('log-out', 18) }}{{ 'Esci'|trans }}</button>
    </form>
</div>
{% endblock %}
