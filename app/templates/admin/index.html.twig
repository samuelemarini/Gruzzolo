{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}
{% block title %}{{ 'Utenti'|trans }}{% endblock %}
{% block body %}
<div class="page">
    <div class="topbar">
        <h1 class="topbar__title">{{ 'Utenti'|trans }}</h1>
        <a href="{{ path('admin_user_new') }}" class="icon-btn" aria-label="{{ 'Nuovo utente'|trans }}">{{ icon('plus') }}</a>
    </div>
    <p class="small muted">{{ 'Ogni utente vede solo i propri dati. I nuovi utenti partono con un conto e un set di categorie da personalizzare.'|trans }}</p>
    <div class="card card--list">
        {% for u in users %}
            <a class="list-row" href="{{ path('admin_user_edit', {id: u.id}) }}" style="{{ not u.active ? 'opacity: .55' }}">
                {{ ui.tile('user', u.admin ? '#FF9EC7' : '#8AB4FF', 'sm') }}
                <div class="list-row__body">
                    <span class="list-row__title">{{ u.displayName }}{% if u.admin %} <span class="badge badge--accent">{{ 'admin'|trans }}</span>{% endif %}{% if not u.active %} <span class="badge">{{ 'disattivato'|trans }}</span>{% endif %}</span>
                    <span class="list-row__meta">{{ u.username }} · {{ '%count% movimento|%count% movimenti'|trans({'%count%': counts[u.id] ?? 0}) }} · {{ 'dal %date%'|trans({'%date%': u.createdAt|local_date('d MMM yyyy')}) }}</span>
                </div>
                {{ icon('chevron-right', 18, 'list-row__chev') }}
            </a>
        {% endfor %}
    </div>
    <a href="{{ path('admin_user_new') }}" class="btn btn--outline btn--block btn--sm">{{ icon('plus', 18) }}{{ 'Nuovo utente'|trans }}</a>
</div>
{% endblock %}
