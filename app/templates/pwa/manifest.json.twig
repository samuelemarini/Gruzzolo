{
    "name": "Gruzzolo",
    "short_name": "Gruzzolo",
    "description": "{{ 'Entrate, uscite, rifornimenti e investimenti'|trans }}",
    "lang": "{{ app.request.locale }}",
    "start_url": "{{ path('app_home') }}",
    "scope": "/",
    "display": "standalone",
    "background_color": "#0D0E0C",
    "theme_color": "#0D0E0C",
    "icons": [
        {"src": "{{ path('pwa_icon', {shape: iconShape, color: iconColor, file: 'icon-192.png'}) }}", "sizes": "192x192", "type": "image/png"},
        {"src": "{{ path('pwa_icon', {shape: iconShape, color: iconColor, file: 'icon-512.png'}) }}", "sizes": "512x512", "type": "image/png"},
        {"src": "{{ path('pwa_icon', {shape: iconShape, color: iconColor, file: 'icon-maskable-512.png'}) }}", "sizes": "512x512", "type": "image/png", "purpose": "maskable"},
        {"src": "{{ path('pwa_icon', {shape: iconShape, color: iconColor, file: 'icon.svg'}) }}", "sizes": "any", "type": "image/svg+xml"}
    ],
    "shortcuts": [
        {"name": "{{ 'Nuovo movimento'|trans }}", "url": "{{ path('movement_new') }}"},
        {"name": "{{ 'Rifornimento'|trans }}", "url": "{{ path('movement_new', {fuel: 1}) }}"}
    ]
}
