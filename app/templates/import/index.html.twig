{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}
{% block title %}{{ 'Importa'|trans }}{% endblock %}
{% block body %}
<div class="page">
    <div class="topbar"><h1 class="topbar__title">{{ 'Importa'|trans }}</h1></div>

    <form method="post" enctype="multipart/form-data" class="card" data-turbo="false" data-controller="upload">
        <input type="hidden" name="_token" value="{{ csrf_token('import-upload') }}">
        <h2 class="h2">{{ 'Carica un file CSV'|trans }}</h2>
        <label class="dropzone" data-upload-target="zone">
            {{ icon('file-up', 30) }}
            <span class="strong" data-upload-target="name">{{ "Scegli il file esportato dall'altra app"|trans }}</span>
            <span class="small muted">{{ 'oppure trascinalo qui'|trans }}</span>
            <input type="file" name="file" accept=".csv,text/csv" required data-action="upload#picked">
        </label>
        {% if error %}<div class="form-error">{{ error }}</div>{% endif %}
        <p class="small muted">{{ "Formati riconosciuti: %formats%. Prima di importare vedrai un'anteprima e potrai scegliere a quali conti e categorie abbinare i dati. Le righe già importate in passato vengono saltate."|trans({'%formats%': formats|join(', ')}) }}</p>
        <button type="submit" class="btn btn--block">{{ icon('upload', 20) }}{{ "Carica e mostra l'anteprima"|trans }}</button>
    </form>

    {% if batches is not empty %}
        <section>
            <div class="section-head"><h2>{{ 'Importazioni fatte'|trans }}</h2></div>
            <div class="card card--list">
                {% for b in batches %}
                    <div class="list-row">
                        {{ ui.tile('file-spreadsheet', '#9BE7A0', 'sm') }}
                        <div class="list-row__body">
                            <span class="list-row__title">{{ b.filename }}</span>
                            <span class="list-row__meta">{{ b.createdAt|local_date('d MMM yyyy, HH:mm') }} · {{ '%count% movimento|%count% movimenti'|trans({'%count%': b.imported}) }}{% if b.firstDate %} {{ 'dal %from% al %to%'|trans({'%from%': b.firstDate|local_date('d MMM yyyy'), '%to%': b.lastDate|local_date('d MMM yyyy')}) }}{% endif %}{{ b.skipped ? ' · ' ~ '%count% saltato|%count% saltati'|trans({'%count%': b.skipped}) }}</span>
                        </div>
                        <form method="post" action="{{ path('import_undo', {id: b.id}) }}" data-confirm-kind="undo" data-turbo-confirm="{{ 'Annullare questa importazione? Vengono eliminati i %n% movimenti importati e le categorie o i conti creati apposta, se non li usi altrove.'|trans({'%n%': b.imported}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('import-undo-' ~ b.id) }}">
                            <button type="submit" class="chip" style="height: 34px">{{ icon('rotate-ccw', 15) }}{{ 'Annulla'|trans }}</button>
                        </form>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}
</div>
{% endblock %}
