{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}
{% block title %}Importa{% endblock %}
{% block body %}
<div class="page">
    <div class="topbar"><h1 class="topbar__title">Importa</h1></div>

    <form method="post" enctype="multipart/form-data" class="card" data-turbo="false" data-controller="upload">
        <input type="hidden" name="_token" value="{{ csrf_token('import-upload') }}">
        <h2 class="h2">Carica un file CSV</h2>
        <label class="dropzone" data-upload-target="zone">
            {{ icon('file-up', 30) }}
            <span class="strong" data-upload-target="name">Scegli il file esportato dall'altra app</span>
            <span class="small muted">oppure trascinalo qui</span>
            <input type="file" name="file" accept=".csv,text/csv" required data-action="upload#picked">
        </label>
        {% if error %}<div class="form-error">{{ error }}</div>{% endif %}
        <p class="small muted">Formati riconosciuti: {{ formats|join(', ') }}. Prima di importare vedrai un'anteprima e potrai scegliere a quali conti e categorie abbinare i dati. Le righe già importate in passato vengono saltate.</p>
        <button type="submit" class="btn btn--block">{{ icon('upload', 20) }}Carica e mostra l'anteprima</button>
    </form>

    {% if batches is not empty %}
        <section>
            <div class="section-head"><h2>Importazioni fatte</h2></div>
            <div class="card card--list">
                {% for b in batches %}
                    <div class="list-row">
                        {{ ui.tile('file-spreadsheet', '#9BE7A0', 'sm') }}
                        <div class="list-row__body">
                            <span class="list-row__title">{{ b.filename }}</span>
                            <span class="list-row__meta">{{ b.createdAt|it_date('d MMM yyyy, HH:mm') }} · {{ b.imported }} movimenti{% if b.firstDate %} dal {{ b.firstDate|it_date('d MMM yyyy') }} al {{ b.lastDate|it_date('d MMM yyyy') }}{% endif %}{{ b.skipped ? ' · ' ~ b.skipped ~ ' saltati' }}</span>
                        </div>
                        <form method="post" action="{{ path('import_undo', {id: b.id}) }}" data-turbo-confirm="Annullare questa importazione? Vengono eliminati i {{ b.imported }} movimenti importati e le categorie o i conti creati apposta, se non li usi altrove.">
                            <input type="hidden" name="_token" value="{{ csrf_token('import-undo-' ~ b.id) }}">
                            <button type="submit" class="chip" style="height: 34px">{{ icon('rotate-ccw', 15) }}Annulla</button>
                        </form>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}
</div>
{% endblock %}
