{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}
{% set hide_tabbar = true %}
{% set isNew = movement.id is null %}
{% set refuel = movement.refuel %}
{% block title %}{{ isNew ? 'Nuovo movimento'|trans : 'Modifica movimento'|trans }}{% endblock %}

{% macro category_picker(tree, movement, kind, account) %}
    {% import '_ui.html.twig' as ui %}
    {% set active = movement.kind == kind and movement.account == account %}
    <div class="cat-groups" data-movement-form-target="categories" data-kind="{{ kind }}" data-account="{{ account.id }}" {{ not active ? 'hidden' }}>
        {% if tree is empty %}
            <p class="small muted">{{ kind == 'income' ? 'Il conto «%name%» non ha categorie di entrata.'|trans({'%name%': account.name}) : 'Il conto «%name%» non ha categorie di uscita.'|trans({'%name%': account.name}) }} <a class="link" href="{{ path('category_index', {account: account.id, kind: kind}) }}">{{ 'Aggiungile'|trans }}</a></p>
        {% endif %}
        <div class="cat-picker" role="radiogroup" aria-label="{{ 'Categoria'|trans }}">
            {% for parent in tree %}
                <label class="cat-pick" data-fuel="{{ parent.fuel ? 1 : 0 }}">
                    <input type="radio" name="category" value="{{ parent.id }}" {{ movement.category == parent ? 'checked' }} {{ not active ? 'disabled' }}
                           data-action="click->movement-form#categoryChanged" data-parent="{{ parent.id }}" data-fuel="{{ parent.fuel ? 1 : 0 }}"
                           data-name="{{ parent.name }}" data-has-children="{{ parent.children|filter(c => not c.archived)|length ? 1 : 0 }}">
                    {{ ui.tile(parent.icon, parent.color) }}
                    <span>{{ parent.name }}</span>
                </label>
            {% endfor %}
        </div>
        {% for parent in tree|filter(p => p.children|filter(c => not c.archived)|length > 0) %}
            <div class="cat-children" data-children-of="{{ parent.id }}" hidden>
                <div class="row" style="gap: 10px">
                    <button type="button" class="icon-btn icon-btn--plain" data-action="movement-form#backToGrid" aria-label="{{ 'Tutte le categorie'|trans }}">{{ icon('chevron-left') }}</button>
                    {{ ui.tile(parent.icon, parent.color, 'sm') }}
                    <span class="strong grow">{{ parent.name }}</span>
                </div>
                <div class="chips">
                <button type="button" class="chip chip--dashed" data-action="movement-form#confirmParent">{{ 'Solo «%name%»'|trans({'%name%': parent.name}) }}</button>
                {% for child in parent.children|filter(c => not c.archived) %}
                    <label class="chip">
                        <input type="radio" name="category" value="{{ child.id }}" {{ movement.category == child ? 'checked' }} {{ not active ? 'disabled' }}
                               data-action="click->movement-form#categoryChanged" data-parent="{{ parent.id }}" data-fuel="{{ child.fuel ? 1 : 0 }}"
                               data-name="{{ parent.name }} › {{ child.name }}">
                        <span class="chip__dot" style="--c: {{ child.color }}"></span>{{ child.name }}
                    </label>
                {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}

{% block body %}
{# Senza categoria si sceglie prima quella (griglia); poi si vedono gli altri campi. #}
<form method="post" class="page page--plain form" data-controller="movement-form keypad" data-turbo="true" data-mode="{{ movement.category is null and not movement.transfer ? 'grid' : 'fields' }}"
      action="{{ app.request.requestUri }}">
    <input type="hidden" name="_token" value="{{ csrf_token('movement') }}">
    <input type="hidden" name="_back" value="{{ back }}">

    <div class="topbar">
        <a href="{{ back ?: path('movement_index') }}" class="icon-btn" aria-label="{{ 'Chiudi'|trans }}">{{ icon('x') }}</a>
        <span class="topbar__center">{{ isNew ? 'Nuovo movimento'|trans : 'Modifica movimento'|trans }}</span>
        {% if not isNew %}
            <a href="{{ path('movement_duplicate', {id: movement.id, back: back}) }}" class="icon-btn" aria-label="{{ 'Duplica'|trans }}">{{ icon('repeat', 18) }}</a>
        {% else %}
            <span style="width: 44px"></span>
        {% endif %}
    </div>

    <div class="seg" role="radiogroup" aria-label="{{ 'Tipo di movimento'|trans }}">
        {% for value, label in {expense: 'Uscita'|trans, income: 'Entrata'|trans, transfer: 'Giroconto'|trans} %}
            <label><input type="radio" name="kind" value="{{ value }}" {{ movement.kind == value ? 'checked' }} data-action="movement-form#kindChanged">{{ label }}</label>
        {% endfor %}
    </div>

    <div class="stack-sm" style="gap: 2px">
        <div class="amount-input">
            <span class="amount-input__sign" data-movement-form-target="sign">{{ movement.income ? '+' : (movement.expense ? '−' : '') }}</span>
            <input type="text" name="amount" inputmode="decimal" autocomplete="off" placeholder="{{ 0|input_num }}" aria-label="{{ 'Importo'|trans }}"
                   value="{{ movement.amount > 0 ? movement.amount|input_num : '' }}"
                   data-keypad-target="input" data-movement-form-target="amount" data-action="beforeinput->keypad#typed paste->keypad#pasted" {{ isNew ? 'autofocus' }}>
            <span class="amount-input__cur">€</span>
        </div>
        {% if errors.amount is defined %}<p class="field__error" style="text-align: center">{{ errors.amount }}</p>{% endif %}
    </div>

    {# Categoria scelta: resta in alto, toccandola si torna alla griglia #}
    <button type="button" class="cat-current fields-only" data-movement-form-target="current" data-action="movement-form#openGrid" hidden>
        <span class="cat-current__tile" data-movement-form-target="currentTile"></span>
        <span class="cat-current__name grow ellipsis" data-movement-form-target="currentName"></span>
        <span class="cat-current__change">{{ 'Cambia'|trans }} {{ icon('chevron-down', 16) }}</span>
    </button>

    <section class="cat-sheet grid-only" aria-label="{{ 'Scegli la categoria'|trans }}">
        {# Conto prima della categoria: ogni conto ha le sue categorie #}
        {% if accounts|length > 1 %}
            <span class="label-caps">{{ 'Conto'|trans }}</span>
            <div class="chips chips--scroll" role="radiogroup" aria-label="{{ 'Conto'|trans }}">
                {% for a in accounts %}
                    <button type="button" class="chip {{ movement.account == a ? 'is-active' }}" role="radio" aria-checked="{{ movement.account == a ? 'true' : 'false' }}"
                            data-movement-form-target="accountChip" data-account="{{ a.id }}" data-action="movement-form#pickAccount">
                        <span class="chip__dot" style="--c: {{ a.color }}"></span>{{ a.name }}
                    </button>
                {% endfor %}
            </div>
        {% endif %}
        <span class="label-caps">{{ 'Categoria'|trans }}</span>
        {% for t in categoryTrees %}
            {{ _self.category_picker(t.expense, movement, 'expense', t.account) }}
            {{ _self.category_picker(t.income, movement, 'income', t.account) }}
        {% endfor %}
    </section>
    {% if errors.category is defined %}<p class="field__error">{{ errors.category }}</p>{% endif %}

    <div class="rows fields-only">
        <label class="rowf" data-movement-form-target="transferOnly" {{ not movement.transfer ? 'hidden' }}>
            <span class="rowf__icon">{{ icon('arrow-left-right') }}</span>
            <span class="rowf__label">{{ 'Verso'|trans }}</span>
            <select name="to_account">
                <option value="">{{ 'Scegli il conto…'|trans }}</option>
                {% for a in accounts %}<option value="{{ a.id }}" {{ movement.toAccount == a ? 'selected' }}>{{ a.name }}</option>{% endfor %}
            </select>
        </label>
        <label class="rowf">
            <span class="rowf__icon">{{ icon('landmark') }}</span>
            <span class="rowf__label" data-movement-form-target="accountLabel">{{ movement.transfer ? 'Da conto'|trans : 'Conto'|trans }}</span>
            <select name="account" data-movement-form-target="account" data-action="movement-form#accountChanged">
                {% for a in accounts %}<option value="{{ a.id }}" {{ movement.account == a ? 'selected' }}>{{ a.name }}{{ a.shared or a.user != app.user ? ' (' ~ 'condiviso'|trans ~ ')' }}</option>{% endfor %}
            </select>
        </label>
        <label class="rowf">
            <span class="rowf__icon">{{ icon('pencil') }}</span>
            <span class="rowf__label">{{ 'Descrizione'|trans }}</span>
            <input type="text" name="description" value="{{ movement.description }}" list="descriptions" maxlength="160" placeholder="{{ 'es. Esselunga'|trans }}" autocomplete="off">
        </label>
        <label class="rowf">
            <span class="rowf__icon">{{ icon('calendar') }}</span>
            <span class="rowf__label">{{ 'Data'|trans }}</span>
            <input type="date" name="date" value="{{ movement.date|date('Y-m-d') }}" required>
        </label>
        {# Etichette: tendina a scelta multipla fra quelle esistenti (si creano dalla sezione Etichette) #}
        {% set tagNames = tagOptions|map(t => t.name) %}
        {% set options = tagOptions|merge(movement.tags|filter(t => t.name not in tagNames)) %}
        {% set chosen = movement.tags|map(t => t.name) %}
        <div class="rowf-wrap" data-controller="tag-select" data-action="click@window->tag-select#outside keydown.esc@window->tag-select#close">
            <div class="rowf">
                <span class="rowf__icon">{{ icon('tag') }}</span>
                <span class="rowf__label">{{ 'Etichette'|trans }}</span>
                <button type="button" class="tag-select__toggle" data-tag-select-target="toggle" data-action="tag-select#toggle" aria-expanded="false" aria-controls="tag-menu">
                    <span class="ellipsis" data-tag-select-target="summary">{{ chosen ? chosen|map(n => '#' ~ n)|join(', ') : 'nessuna'|trans }}</span>
                    {{ icon('chevron-down', 18, 'tag-select__chev') }}
                </button>
            </div>
            <div class="tag-select__menu" id="tag-menu" data-tag-select-target="menu" hidden>
                {% for t in options %}
                    <label class="tag-option">
                        <input type="checkbox" name="tags[]" value="{{ t.name }}" data-action="tag-select#changed" {{ t.name in chosen ? 'checked' }}>
                        <span class="dot" style="--c: {{ t.color }}"></span>
                        <span class="grow ellipsis">#{{ t.name }}{% if t.title %} <span class="muted">· {{ t.title }}</span>{% endif %}</span>
                        {{ icon('check', 18, 'tag-option__check') }}
                    </label>
                {% else %}
                    <p class="small muted" style="margin: 12px 0">{{ 'Nessuna etichetta.'|trans }} <a class="link" href="{{ path('tag_new') }}">{{ 'Creane una dalla sezione Etichette'|trans }}</a>.</p>
                {% endfor %}
            </div>
        </div>
        <label class="rowf" data-movement-form-target="vehicleRow" {{ not movement.expense or (movement.category and movement.category.fuel) or vehicles is empty ? 'hidden' }}>
            <span class="rowf__icon">{{ icon('car') }}</span>
            <span class="rowf__label">{{ 'Veicolo'|trans }}</span>
            <select name="vehicle" data-movement-form-target="vehicleSelect">
                <option value="">{{ 'Nessuno'|trans }}</option>
                {% for v in vehicles %}<option value="{{ v.id }}" {{ movement.vehicle == v ? 'selected' }}>{{ v.name }}</option>{% endfor %}
            </select>
        </label>
        <label class="rowf">
            <span class="rowf__icon">{{ icon('sticky-note') }}</span>
            <span class="rowf__label">{{ 'Nota'|trans }}</span>
            <input type="text" name="note" value="{{ movement.note }}" placeholder="{{ 'facoltativa'|trans }}">
        </label>
    </div>
    {% for field in ['date', 'account', 'to_account'] %}
        {% if errors[field] is defined %}<p class="field__error">{{ errors[field] }}</p>{% endif %}
    {% endfor %}

    {# --- Rifornimento: compare con una categoria carburante --- #}
    <section class="card card--tight fields-only" data-movement-form-target="fuel" data-controller="fuel"
             data-fuel-odometers-value="{{ lastOdometers|json_encode }}"
             data-fuel-averages-value="{{ averages|json_encode }}"
             {{ not (movement.category and movement.category.fuel and movement.expense) ? 'hidden' }}>
        <div class="row row--between">
            <h2 class="h2" style="font-size: 17px">{{ 'Rifornimento'|trans }}</h2>
            <a href="{{ path('vehicle_index') }}" class="link small">{{ 'Gestisci veicoli'|trans }}</a>
        </div>

        {% if vehicles is empty %}
            <p class="small muted">{{ 'Per registrare i rifornimenti aggiungi prima un veicolo.'|trans }}</p>
            <a href="{{ path('vehicle_new', {back: app.request.requestUri}) }}" class="btn btn--sm btn--ghost">{{ icon('plus', 18) }}{{ 'Aggiungi veicolo'|trans }}</a>
        {% else %}
            {% set currentVehicle = movement.vehicle ?? vehicles|first %}
            <div class="grid-2" role="radiogroup" aria-label="{{ 'Veicolo'|trans }}">
                {% for v in vehicles %}
                    <label class="chip" style="height: auto; padding: 10px; border-radius: 16px; gap: 10px; white-space: normal">
                        <input type="radio" name="vehicle" value="{{ v.id }}" {{ currentVehicle == v ? 'checked' }} data-action="fuel#vehicleChanged" data-fuel-target="vehicle" data-electric="{{ v.electric ? 1 : 0 }}" {{ not (movement.category and movement.category.fuel) ? 'disabled' }}>
                        {{ icon(v.icon, 22) }}
                        <span class="stack-sm" style="gap: 1px; min-width: 0"><span class="strong ellipsis" style="font-size: 14px">{{ v.name }}</span><span class="xsmall muted">{{ v.fuelLabel }}{{ v.plate ? ' · ' ~ v.plate }}</span></span>
                    </label>
                {% endfor %}
            </div>
            {% if errors.vehicle is defined %}<p class="field__error">{{ errors.vehicle }}</p>{% endif %}

            <label class="field {{ errors.odometer is defined ? 'has-error' }}">
                <span class="field__label"><span>{{ 'Chilometri attuali'|trans }}</span><span data-fuel-target="lastKm"></span></span>
                <span class="row" style="gap: 10px">
                    <input type="text" inputmode="numeric" name="refuel[odometer]" value="{{ refuel ? refuel.odometer : '' }}" placeholder="{{ 'es. %value%'|trans({'%value%': 48215}) }}" style="font-size: 20px; font-weight: 600; max-width: 140px" data-fuel-target="odometer" data-action="input->fuel#update" autocomplete="off">
                    <span class="small strong text-accent" data-fuel-target="delta"></span>
                </span>
            </label>

            <div class="stack-sm" style="gap: 6px">
                <div class="grid-3">
                    <label class="field" data-fuel-target="priceBox">
                        <span class="field__label" data-fuel-target="priceLabel">{{ '€ / litro'|trans }}</span>
                        <input type="text" inputmode="decimal" name="refuel[price]" value="{{ refuel ? refuel.pricePerLiter|input_num(3) : '' }}" placeholder="{{ 1.799|input_num(3) }}" data-fuel-target="price" data-action="input->fuel#edited" data-field="price" autocomplete="off">
                    </label>
                    <label class="field" data-fuel-target="litersBox">
                        <span class="field__label" data-fuel-target="litersLabel">{{ 'Litri'|trans }}</span>
                        <input type="text" inputmode="decimal" name="refuel[liters]" value="{{ refuel ? refuel.liters|input_num(2) : '' }}" placeholder="{{ 34.46|input_num(2) }}" data-fuel-target="liters" data-action="input->fuel#edited" data-field="liters" autocomplete="off">
                    </label>
                    <label class="field" data-fuel-target="totalBox">
                        <span class="field__label">{{ 'Totale €'|trans }}</span>
                        <input type="text" inputmode="decimal" value="{{ movement.amount > 0 ? movement.amount|input_num : '' }}" placeholder="{{ 62|input_num }}" data-fuel-target="total" data-action="input->fuel#edited" data-field="total" autocomplete="off" aria-label="{{ "Totale (uguale all'importo)"|trans }}">
                    </label>
                </div>
                <p class="hint">{{ 'Inserisci due valori qualsiasi, il terzo si calcola da solo.'|trans }}</p>
                {% if errors.liters is defined %}<p class="field__error">{{ errors.liters }}</p>{% endif %}
            </div>

            <div>
                <label class="switch">
                    <span class="switch__text"><span>{{ 'Pieno'|trans }}</span><small>{{ 'serve per calcolare il consumo'|trans }}</small></span>
                    <input type="checkbox" name="refuel[full]" value="1" {{ refuel is null or refuel.fullTank ? 'checked' }} data-fuel-target="full" data-action="fuel#update">
                </label>
                <label class="switch">
                    <span class="switch__text"><span>{{ 'Ho saltato un rifornimento'|trans }}</span><small>{{ 'esclude questo pieno dalla media'|trans }}</small></span>
                    <input type="checkbox" name="refuel[missed]" value="1" {{ refuel and refuel.missedPrevious ? 'checked' }} data-action="fuel#update" data-fuel-target="missed">
                </label>
            </div>

            <div class="grid-3 card--outline" style="border-radius: 18px; padding: 12px" data-fuel-target="preview" hidden>
                <div class="stack-sm" style="align-items: center; gap: 2px"><span class="display strong text-accent" style="font-size: 18px" data-fuel-target="effValue">—</span><span class="xsmall muted" data-fuel-target="effUnit">km/l</span></div>
                <div class="stack-sm" style="align-items: center; gap: 2px"><span class="display strong" style="font-size: 18px" data-fuel-target="per100Value">—</span><span class="xsmall muted" data-fuel-target="per100Unit">l/100 km</span></div>
                <div class="stack-sm" style="align-items: center; gap: 2px"><span class="display strong" style="font-size: 18px" data-fuel-target="perKmValue">—</span><span class="xsmall muted">{{ '€ al km'|trans }}</span></div>
            </div>
            <div class="fuel-average" data-fuel-target="average" hidden>
                <div class="row row--between">
                    <span class="small muted">{{ "Media dell'auto"|trans }} · <span data-fuel-target="averageLabel">{{ '12 mesi'|trans }}</span></span>
                    <strong class="small" style="white-space: nowrap" data-fuel-target="averageValue">—</strong>
                </div>
                <span class="xsmall strong" data-fuel-target="averageCompare"></span>
            </div>
        {% endif %}
    </section>

    {# Tastierino e Salva restano fissi in basso: sopra scorre il resto del modulo #}
    <div class="form-dock">
        <div class="keypad" data-keypad-target="pad" aria-label="{{ 'Tastierino'|trans }}">
            {% for k in ['1','2','3','4','5','6','7','8','9',','] %}
                {# Il tasto dei decimali mostra il separatore della lingua, data-key resta "," #}
                <button type="button" data-action="keypad#press" data-key="{{ k }}">{{ k == ',' ? number_separators()[0] : k }}</button>
            {% endfor %}
            <button type="button" data-action="keypad#press" data-key="0">0</button>
            <button type="button" data-action="keypad#back" aria-label="{{ 'Cancella'|trans }}">{{ icon('delete', 22) }}</button>
        </div>
        <div class="form-dock__actions {{ isNew ? 'has-another' : 'has-delete' }}">
            {# Salva per primo: e' quello che parte premendo Invio in un campo #}
            <button type="submit" class="btn">{{ icon('check', 20) }}<span data-movement-form-target="submitLabel">{{ isNew ? 'Salva'|trans : 'Salva modifiche'|trans }}</span></button>
            {% if isNew %}
                <button type="submit" name="_another" value="1" class="btn btn--ghost form-dock__another">{{ icon('plus', 18) }}{{ 'Salva e nuovo'|trans }}</button>
            {% else %}
                {# Invia il modulo di eliminazione qui sotto (i form non si annidano) #}
                <button type="submit" form="movement-delete" class="btn btn--danger form-dock__delete" aria-label="{{ 'Elimina movimento'|trans }}" title="{{ 'Elimina movimento'|trans }}">{{ icon('trash-2', 20) }}</button>
            {% endif %}
        </div>
    </div>

    <datalist id="descriptions">{% for d in descriptions %}<option value="{{ d }}">{% endfor %}</datalist>
</form>

{% if not isNew %}
    <form id="movement-delete" method="post" action="{{ path('movement_delete', {id: movement.id}) }}" data-confirm-kind="delete" data-turbo-confirm="{{ 'Eliminare questo movimento?'|trans }}" hidden>
        <input type="hidden" name="_token" value="{{ csrf_token('delete-movement-' ~ movement.id) }}">
        <input type="hidden" name="_back" value="{{ back }}">
    </form>
{% endif %}
{% endblock %}
