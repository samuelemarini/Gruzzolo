{% extends 'base.html.twig' %}
{% import '_ui.html.twig' as ui %}
{% set hide_tabbar = true %}
{% set isNew = movement.id is null %}
{% set refuel = movement.refuel %}
{% block title %}{{ isNew ? 'Nuovo movimento' : 'Modifica movimento' }}{% endblock %}

{% macro category_picker(tree, movement, kind, account) %}
    {% import '_ui.html.twig' as ui %}
    {% set active = movement.kind == kind and movement.account == account %}
    <div class="cat-groups" data-movement-form-target="categories" data-kind="{{ kind }}" data-account="{{ account.id }}" {{ not active ? 'hidden' }}>
        {% if tree is empty %}
            <p class="small muted">Il conto «{{ account.name }}» non ha categorie di {{ kind == 'income' ? 'entrata' : 'uscita' }}. <a class="link" href="{{ path('category_index', {account: account.id, kind: kind}) }}">Aggiungile</a></p>
        {% endif %}
        <div class="cat-picker" role="radiogroup" aria-label="Categoria">
            {% for parent in tree %}
                <label class="cat-pick" data-fuel="{{ parent.fuel ? 1 : 0 }}">
                    <input type="radio" name="category" value="{{ parent.id }}" {{ movement.category == parent ? 'checked' }} {{ not active ? 'disabled' }}
                           data-action="movement-form#categoryChanged" data-parent="{{ parent.id }}" data-fuel="{{ parent.fuel ? 1 : 0 }}">
                    {{ ui.tile(parent.icon, parent.color) }}
                    <span>{{ parent.name }}</span>
                    {% if movement.category and movement.category.parent == parent %}<span class="cat-pick__sub">› {{ movement.category.name }}</span>{% endif %}
                </label>
            {% endfor %}
        </div>
        {% for parent in tree|filter(p => p.children|filter(c => not c.archived)|length > 0) %}
            {% set open = movement.category and (movement.category == parent or movement.category.parent == parent) %}
            <div class="cat-children chips" data-children-of="{{ parent.id }}" {{ not open ? 'hidden' }}>
                {% for child in parent.children|filter(c => not c.archived) %}
                    <label class="chip">
                        <input type="radio" name="category" value="{{ child.id }}" {{ movement.category == child ? 'checked' }} {{ not active ? 'disabled' }}
                               data-action="movement-form#categoryChanged" data-parent="{{ parent.id }}" data-fuel="{{ child.fuel ? 1 : 0 }}">
                        <span class="chip__dot" style="--c: {{ child.color }}"></span>{{ child.name }}
                    </label>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
{% endmacro %}

{% block body %}
<form method="post" class="page page--plain form" data-controller="movement-form keypad" data-turbo="true"
      action="{{ app.request.requestUri }}">
    <input type="hidden" name="_token" value="{{ csrf_token('movement') }}">
    <input type="hidden" name="_back" value="{{ back }}">

    <div class="topbar">
        <a href="{{ back ?: path('movement_index') }}" class="icon-btn" aria-label="Chiudi">{{ icon('x') }}</a>
        <span class="topbar__center">{{ isNew ? 'Nuovo movimento' : 'Modifica movimento' }}</span>
        {% if not isNew %}
            <a href="{{ path('movement_duplicate', {id: movement.id, back: back}) }}" class="icon-btn" aria-label="Duplica">{{ icon('repeat', 18) }}</a>
        {% else %}
            <span style="width: 44px"></span>
        {% endif %}
    </div>

    <div class="seg" role="radiogroup" aria-label="Tipo di movimento">
        {% for value, label in {expense: 'Uscita', income: 'Entrata', transfer: 'Giroconto'} %}
            <label><input type="radio" name="kind" value="{{ value }}" {{ movement.kind == value ? 'checked' }} data-action="movement-form#kindChanged">{{ label }}</label>
        {% endfor %}
    </div>

    <div class="stack-sm" style="gap: 2px">
        <div class="amount-input">
            <span class="amount-input__sign" data-movement-form-target="sign">{{ movement.income ? '+' : (movement.expense ? '−' : '') }}</span>
            <input type="text" name="amount" inputmode="decimal" autocomplete="off" placeholder="0,00" aria-label="Importo"
                   value="{{ movement.amount > 0 ? movement.amount|input_num : '' }}"
                   data-keypad-target="input" data-movement-form-target="amount" {{ isNew ? 'autofocus' }}>
            <span class="amount-input__cur">€</span>
        </div>
        {% if errors.amount is defined %}<p class="field__error" style="text-align: center">{{ errors.amount }}</p>{% endif %}
    </div>

    {% for t in categoryTrees %}
        {{ _self.category_picker(t.expense, movement, 'expense', t.account) }}
        {{ _self.category_picker(t.income, movement, 'income', t.account) }}
    {% endfor %}
    {% if errors.category is defined %}<p class="field__error">{{ errors.category }}</p>{% endif %}

    <div class="rows">
        <label class="rowf" data-movement-form-target="transferOnly" {{ not movement.transfer ? 'hidden' }}>
            <span class="rowf__icon">{{ icon('arrow-left-right') }}</span>
            <span class="rowf__label">Verso</span>
            <select name="to_account">
                <option value="">Scegli il conto…</option>
                {% for a in accounts %}<option value="{{ a.id }}" {{ movement.toAccount == a ? 'selected' }}>{{ a.name }}</option>{% endfor %}
            </select>
        </label>
        <label class="rowf">
            <span class="rowf__icon">{{ icon('landmark') }}</span>
            <span class="rowf__label" data-movement-form-target="accountLabel">{{ movement.transfer ? 'Da conto' : 'Conto' }}</span>
            <select name="account" data-movement-form-target="account" data-action="movement-form#accountChanged">
                {% for a in accounts %}<option value="{{ a.id }}" {{ movement.account == a ? 'selected' }}>{{ a.name }}{{ a.shared or a.user != app.user ? ' (condiviso)' }}</option>{% endfor %}
            </select>
        </label>
        <label class="rowf">
            <span class="rowf__icon">{{ icon('pencil') }}</span>
            <span class="rowf__label">Descrizione</span>
            <input type="text" name="description" value="{{ movement.description }}" list="descriptions" maxlength="160" placeholder="es. Esselunga" autocomplete="off">
        </label>
        <label class="rowf">
            <span class="rowf__icon">{{ icon('calendar') }}</span>
            <span class="rowf__label">Data</span>
            <input type="date" name="date" value="{{ movement.date|date('Y-m-d') }}" required>
        </label>
        {# Etichette: tendina a scelta multipla fra quelle esistenti (si creano dalla sezione Etichette) #}
        {% set tagNames = tagOptions|map(t => t.name) %}
        {% set options = tagOptions|merge(movement.tags|filter(t => t.name not in tagNames)) %}
        {% set chosen = movement.tags|map(t => t.name) %}
        <div class="rowf-wrap" data-controller="tag-select" data-action="click@window->tag-select#outside keydown.esc@window->tag-select#close">
            <div class="rowf">
                <span class="rowf__icon">{{ icon('tag') }}</span>
                <span class="rowf__label">Etichette</span>
                <button type="button" class="tag-select__toggle" data-tag-select-target="toggle" data-action="tag-select#toggle" aria-expanded="false" aria-controls="tag-menu">
                    <span class="ellipsis" data-tag-select-target="summary">{{ chosen ? chosen|map(n => '#' ~ n)|join(', ') : 'nessuna' }}</span>
                    {{ icon('chevron-down', 18, 'tag-select__chev') }}
                </button>
            </div>
            <div class="tag-select__menu" id="tag-menu" data-tag-select-target="menu" hidden>
                {% for t in options %}
                    <label class="tag-option">
                        <input type="checkbox" name="tags[]" value="{{ t.name }}" data-action="tag-select#changed" {{ t.name in chosen ? 'checked' }}>
                        <span class="dot" style="--c: {{ t.color }}"></span>
                        <span class="grow ellipsis">#{{ t.name }}{% if t.title %} <span class="muted">· {{ t.title }}</span>{% endif %}</span>
                        {{ icon('check', 18, 'tag-option__check') }}
                    </label>
                {% else %}
                    <p class="small muted" style="margin: 12px 0">Nessuna etichetta. <a class="link" href="{{ path('tag_new') }}">Creane una dalla sezione Etichette</a>.</p>
                {% endfor %}
            </div>
        </div>
        <label class="rowf" data-movement-form-target="vehicleRow" {{ not movement.expense or (movement.category and movement.category.fuel) or vehicles is empty ? 'hidden' }}>
            <span class="rowf__icon">{{ icon('car') }}</span>
            <span class="rowf__label">Veicolo</span>
            <select name="vehicle" data-movement-form-target="vehicleSelect">
                <option value="">Nessuno</option>
                {% for v in vehicles %}<option value="{{ v.id }}" {{ movement.vehicle == v ? 'selected' }}>{{ v.name }}</option>{% endfor %}
            </select>
        </label>
        <label class="rowf">
            <span class="rowf__icon">{{ icon('sticky-note') }}</span>
            <span class="rowf__label">Nota</span>
            <input type="text" name="note" value="{{ movement.note }}" placeholder="facoltativa">
        </label>
    </div>
    {% for field in ['date', 'account', 'to_account'] %}
        {% if errors[field] is defined %}<p class="field__error">{{ errors[field] }}</p>{% endif %}
    {% endfor %}

    {# --- Rifornimento: compare con una categoria carburante --- #}
    <section class="card card--tight" data-movement-form-target="fuel" data-controller="fuel"
             data-fuel-odometers-value="{{ lastOdometers|json_encode }}"
             data-fuel-averages-value="{{ averages|json_encode }}"
             {{ not (movement.category and movement.category.fuel and movement.expense) ? 'hidden' }}>
        <div class="row row--between">
            <h2 class="h2" style="font-size: 17px">Rifornimento</h2>
            <a href="{{ path('vehicle_index') }}" class="link small">Gestisci veicoli</a>
        </div>

        {% if vehicles is empty %}
            <p class="small muted">Per registrare i rifornimenti aggiungi prima un veicolo.</p>
            <a href="{{ path('vehicle_new', {back: app.request.requestUri}) }}" class="btn btn--sm btn--ghost">{{ icon('plus', 18) }}Aggiungi veicolo</a>
        {% else %}
            {% set currentVehicle = movement.vehicle ?? vehicles|first %}
            <div class="grid-2" role="radiogroup" aria-label="Veicolo">
                {% for v in vehicles %}
                    <label class="chip" style="height: auto; padding: 10px; border-radius: 16px; gap: 10px; white-space: normal">
                        <input type="radio" name="vehicle" value="{{ v.id }}" {{ currentVehicle == v ? 'checked' }} data-action="fuel#vehicleChanged" data-fuel-target="vehicle" data-electric="{{ v.electric ? 1 : 0 }}" {{ not (movement.category and movement.category.fuel) ? 'disabled' }}>
                        {{ icon(v.icon, 22) }}
                        <span class="stack-sm" style="gap: 1px; min-width: 0"><span class="strong ellipsis" style="font-size: 14px">{{ v.name }}</span><span class="xsmall muted">{{ v.fuelLabel }}{{ v.plate ? ' · ' ~ v.plate }}</span></span>
                    </label>
                {% endfor %}
            </div>
            {% if errors.vehicle is defined %}<p class="field__error">{{ errors.vehicle }}</p>{% endif %}

            <label class="field {{ errors.odometer is defined ? 'has-error' }}">
                <span class="field__label"><span>Chilometri attuali</span><span data-fuel-target="lastKm"></span></span>
                <span class="row" style="gap: 10px">
                    <input type="text" inputmode="numeric" name="refuel[odometer]" value="{{ refuel ? refuel.odometer : '' }}" placeholder="es. 48215" style="font-size: 20px; font-weight: 600; max-width: 140px" data-fuel-target="odometer" data-action="input->fuel#update" autocomplete="off">
                    <span class="small strong text-accent" data-fuel-target="delta"></span>
                </span>
            </label>

            <div class="stack-sm" style="gap: 6px">
                <div class="grid-3">
                    <label class="field" data-fuel-target="priceBox">
                        <span class="field__label" data-fuel-target="priceLabel">€ / litro</span>
                        <input type="text" inputmode="decimal" name="refuel[price]" value="{{ refuel ? refuel.pricePerLiter|input_num(3) : '' }}" placeholder="1,799" data-fuel-target="price" data-action="input->fuel#edited" data-field="price" autocomplete="off">
                    </label>
                    <label class="field" data-fuel-target="litersBox">
                        <span class="field__label" data-fuel-target="litersLabel">Litri</span>
                        <input type="text" inputmode="decimal" name="refuel[liters]" value="{{ refuel ? refuel.liters|input_num(2) : '' }}" placeholder="34,46" data-fuel-target="liters" data-action="input->fuel#edited" data-field="liters" autocomplete="off">
                    </label>
                    <label class="field" data-fuel-target="totalBox">
                        <span class="field__label">Totale €</span>
                        <input type="text" inputmode="decimal" value="{{ movement.amount > 0 ? movement.amount|input_num : '' }}" placeholder="62,00" data-fuel-target="total" data-action="input->fuel#edited" data-field="total" autocomplete="off" aria-label="Totale (uguale all'importo)">
                    </label>
                </div>
                <p class="hint">Inserisci due valori qualsiasi, il terzo si calcola da solo.</p>
                {% if errors.liters is defined %}<p class="field__error">{{ errors.liters }}</p>{% endif %}
            </div>

            <div>
                <label class="switch">
                    <span class="switch__text"><span>Pieno</span><small>serve per calcolare il consumo</small></span>
                    <input type="checkbox" name="refuel[full]" value="1" {{ refuel is null or refuel.fullTank ? 'checked' }} data-fuel-target="full" data-action="fuel#update">
                </label>
                <label class="switch">
                    <span class="switch__text"><span>Ho saltato un rifornimento</span><small>esclude questo pieno dalla media</small></span>
                    <input type="checkbox" name="refuel[missed]" value="1" {{ refuel and refuel.missedPrevious ? 'checked' }} data-action="fuel#update" data-fuel-target="missed">
                </label>
            </div>

            <div class="grid-3 card--outline" style="border-radius: 18px; padding: 12px" data-fuel-target="preview" hidden>
                <div class="stack-sm" style="align-items: center; gap: 2px"><span class="display strong text-accent" style="font-size: 18px" data-fuel-target="effValue">—</span><span class="xsmall muted" data-fuel-target="effUnit">km/l</span></div>
                <div class="stack-sm" style="align-items: center; gap: 2px"><span class="display strong" style="font-size: 18px" data-fuel-target="per100Value">—</span><span class="xsmall muted" data-fuel-target="per100Unit">l/100 km</span></div>
                <div class="stack-sm" style="align-items: center; gap: 2px"><span class="display strong" style="font-size: 18px" data-fuel-target="perKmValue">—</span><span class="xsmall muted">€ al km</span></div>
            </div>
            <div class="fuel-average" data-fuel-target="average" hidden>
                <div class="row row--between">
                    <span class="small muted">Media dell'auto · <span data-fuel-target="averageLabel">12 mesi</span></span>
                    <strong class="small" style="white-space: nowrap" data-fuel-target="averageValue">—</strong>
                </div>
                <span class="xsmall strong" data-fuel-target="averageCompare"></span>
            </div>
        {% endif %}
    </section>

    {# Tastierino e Salva restano fissi in basso: sopra scorre il resto del modulo #}
    <div class="form-dock">
        <div class="keypad" data-keypad-target="pad" aria-label="Tastierino">
            {% for k in ['1','2','3','4','5','6','7','8','9',','] %}
                <button type="button" data-action="keypad#press" data-key="{{ k }}">{{ k }}</button>
            {% endfor %}
            <button type="button" data-action="keypad#press" data-key="0">0</button>
            <button type="button" data-action="keypad#back" aria-label="Cancella">{{ icon('delete', 22) }}</button>
        </div>
        <div class="form-dock__actions {{ isNew ? 'has-another' }}">
            {# Salva per primo: e' quello che parte premendo Invio in un campo #}
            <button type="submit" class="btn">{{ icon('check', 20) }}<span data-movement-form-target="submitLabel">{{ isNew ? 'Salva' : 'Salva modifiche' }}</span></button>
            {% if isNew %}
                <button type="submit" name="_another" value="1" class="btn btn--ghost form-dock__another">{{ icon('plus', 18) }}Salva e nuovo</button>
            {% endif %}
        </div>
    </div>

    <datalist id="descriptions">{% for d in descriptions %}<option value="{{ d }}">{% endfor %}</datalist>
</form>

{% if not isNew %}
    <form method="post" action="{{ path('movement_delete', {id: movement.id}) }}" class="page page--plain" style="padding-top: 0" data-turbo-confirm="Eliminare questo movimento?">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-movement-' ~ movement.id) }}">
        <input type="hidden" name="_back" value="{{ back }}">
        <button type="submit" class="btn btn--danger btn--block btn--sm">{{ icon('trash-2', 18) }}Elimina movimento</button>
    </form>
{% endif %}
{% endblock %}
